# Production document root — booking.hakimerad.com
#
# Environment-owned file: the release artifact does not overwrite it. deploy.sh preserves
# whatever .htaccess is in public_html and republishes only the application files.
#
# Legacy paths are redirected here because the live site this replaces served them, and
# referrers hold printed links and bookmarks. Keep the order: redirects, then the front
# controller.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ADR-013 (accepted 2026-11-17): referrals are the clinical intake, `bookings` has no
    # public route, and there is no anonymous submission. `/request` used to accept one;
    # it now lands on the account-request form, which is the flow ADR-013 promised and
    # which shipped on 18 November 2026. The form asks for an account, not a referral.
    RewriteRule ^request/?$                      /request-account [R=301,L]

    RewriteRule ^referrers/?$                    /my-referrals [R=301,L]

    # `/procedures` was the live index of the procedure pages and is listed in the live
    # sitemap at booking.hakimerad.com. Release 1 serves that list at /services, so the
    # indexed URL goes there rather than 404ing. The two slug rules below cover the only
    # procedure pages the live site published.
    RewriteRule ^procedures/?$                   /services [R=301,L]
    RewriteRule ^procedures/biopsy-fnac/?$       /services/fnac [R=301,L]
    RewriteRule ^procedures/abscess-drainage/?$  /services/abscess_drainage [R=301,L]

    # The build has no contact route; the institutional site owns that page.
    RewriteRule ^contact/?$                      https://hakimerad.com/contact.html [R=301,L]

    # Owner decision, 18 November 2026: a legacy path with no Release 1 equivalent is
    # redirected to the institutional site rather than authored here. `/how-it-works`
    # described the old build's process; the landing page is the institutional home
    # until the owner names a deeper target.
    RewriteRule ^how-it-works/?$                 https://hakimerad.com/ [R=301,L]

    # Deliberately NOT redirected: `/privacy` and `/booking-policy`. This application
    # serves both, and a redirect here would win before index.php ever sees the request,
    # making the published privacy notice unreachable at its own URL. They return 404
    # until a version is published with an approver and a review date.
    # `/referral-guidance` is the same case.

    # Do not rewrite real files (assets, manifest, service worker).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve dotfiles or backup/editor leftovers.
<FilesMatch "(^\.|\.(env|ini|log|sql|bak|swp|old)$)">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
