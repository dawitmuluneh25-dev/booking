<?xml version="1.0"?>
<ruleset name="Booking">
    <description>PSR-12 with a 120 character line limit.</description>

    <file>src</file>
    <file>tests</file>
    <file>routes</file>
    <file>public</file>
    <!-- `bin/console` is deliberately NOT listed: phpcs takes the extension from the
         filename, finds none, and skips the file without a word. It is a 22-line loader;
         the code it loads is bin/console.php, below. Listing `bin/console` here would be
         a comment pretending to be a check. -->
    <file>bin/console.php</file>
    <file>bin/ci-status.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>
</ruleset>
