{
    "name": "booking/booking-app",
    "description": "Minimal PHP 8.3 booking web application with a server-rendered PWA shell",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3 <8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.36"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "serve": "php -S 127.0.0.1:8000 -t public dev-router.php",
        "migrate": "php bin/console migrate",
        "doctor": "php bin/console doctor"
    }
}
