# Local environment
.env
.env.*
!.env.example

# Dependencies
/vendor/

# Runtime data
/var/cache/*
/var/logs/*
!/var/cache/.gitkeep
!/var/logs/.gitkeep

# Application data — may hold patient records, so it must never be committed.
# Only the schema (database/migrations) belongs in version control.
/var/data/
/var/private-uploads/

# Local tooling (portable PHP/Composer live outside the repo)
/.tools/

# Editor / OS noise
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Artifacts
/build/
/coverage/
*.log
*.sql.gz

# Backups
/var/backups/*
!/var/backups/.gitkeep
