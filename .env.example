APP_NAME="Booking"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database (MySQL 8.0+ / InnoDB / utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=booking_app
DB_USER=booking_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Sessions
SESSION_NAME=booking_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Logging
LOG_LEVEL=debug

# Notifications (log in development, http through a gateway bridge in production)
NOTIFY_DRIVER=log
NOTIFY_HTTP_URL=
NOTIFY_HTTP_TOKEN=
NOTIFY_HTTP_TIMEOUT=5

# Personal data is redacted from finished bookings after this many days (minimum 30)
RETENTION_DAYS=730
