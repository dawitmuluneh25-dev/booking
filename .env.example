APP_NAME="Booking"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Keyed hash for the public form's per-network counter. Set a long random value in
# production; empty derives one from this installation's database credentials
# (non-portable, but never reversible by enumeration).
APP_SECRET=
APP_TIMEZONE=UTC

# Database (MySQL 8.0+ / InnoDB / utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=booking_app
DB_USER=booking_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Sessions
SESSION_NAME=booking_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Logging
LOG_LEVEL=debug

# Notifications (log in development; brevo for transactional email per O-3-DEC-01)
NOTIFY_DRIVER=log
NOTIFY_HTTP_URL=
NOTIFY_HTTP_TOKEN=
NOTIFY_HTTP_TIMEOUT=5

# Brevo transactional email. The credential is a service key, never the account
# password, and it belongs in the hosting secret store rather than in this file
# wherever the host can inject it. Leave the key empty to keep sending disabled:
# an unconfigured credential fails per message instead of silently succeeding.
NOTIFY_BREVO_API_KEY=
NOTIFY_BREVO_SENDER=notifications@hakimerad.com
NOTIFY_BREVO_SENDER_NAME=HakimeRAD

# Production sending stays off until the O-3 section 8 evidence is accepted.
# Staging and development send regardless, so staging can be tested.
NOTIFY_PRODUCTION_APPROVED=false

# Personal data is redacted from finished bookings after this many days (minimum 30).
# Legal/Data Protection directed seven years on 20 November 2026, on the Ethiopian medical
# record-keeping directive (DEC-2026-11-20-03), and the privacy notice must describe what
# this value actually does, so the two are kept in step.
#
# 2557 and not 2555: a seven-year span containing two leap days — 2028-02-29 and
# 2032-02-29, for instance — is 2557 days long. A smaller number would redact a
# medical record one or two days before the period it was promised for. Erring
# long costs a day; erring short breaks the promise.
RETENTION_DAYS=2557

# Encrypts database dumps at rest (HR-OPS-REF-R1-001 §9). Generate one with
# `php bin/console db:backup --key`, which prints it once and stores nothing.
#
# Empty is a supported value and means "dumps are plain gzipped SQL": every backup command
# says so on its output, and `db:backup --require-encryption` refuses to run rather than
# write one. That flag is how a cron entry fails closed once a key exists.
#
# Custody matters more than the algorithm. A key stored beside the database password on the
# same host protects a copied file — a download, an emailed archive, a synced folder — not a
# compromised host. Keep a copy where the application cannot read it: a lost key makes the
# backups unreadable rather than recoverable.
BACKUP_ENCRYPTION_KEY=

# The independent copy of that key required by D-08 — a path this host can read, pointing at
# storage it does not own. `backup:key-check` reports a warning on every run until it is set,
# because losing the only copy loses every archive with it.
BACKUP_RECOVERY_KEY_FILE=

# Whether D-02's per-class retention schedule may run. Off, and setting it is a Legal decision:
# D-02 makes Legal/Data Protection validation of the periods and exceptions a precondition of
# production activation, not an engineering preference.
RETENTION_SCHEDULE_ACTIVE=false

# Private documents (kept outside public/ so no URL can reach them)
# 15 MiB is the reviewed per-file cap; the host allows 64 MiB, which is not a reason to accept it.
DOCUMENT_STORAGE_PATH=var/private-uploads
DOCUMENT_MAX_BYTES=15728640
# Narrow the reviewed allowlist if a deployment does not need a format. Adding an
# extension that is not in DocumentTypes::CATALOGUE fails at boot rather than
# silently widening what may be stored.
DOCUMENT_TYPES=pdf,jpg,jpeg,png

# Single-use status links. A security default, not a clinical retention period.
TRACKING_LINK_TTL_MINUTES=1440
