#!/usr/bin/env php
<?php

/**
 * Entry point for the operator console.
 *
 * The console body lives in `bin/console.php`. The reason is the style gate: `phpcs`
 * decides what to check from a file's extension, and a file named `console` has none,
 * so 1,219 lines of the most-executed code in this project were never linted â€” a
 * 160-character line planted in them passed the gate, which is how that was proven.
 *
 * The name cannot be changed to `console.php` instead: `deploy.sh` runs
 * `bin/console migrate` and `bin/console migrate:status`, and five cron jobs on the
 * host call `bin/console outbox:dispatch`, `db:backup`, `retention:purge` and `diag`.
 * A rename the linter likes would silently stop the outbox and the backups.
 *
 * Keep this file a loader. `ConsoleEntryPointTest` fails if it grows logic of its own.
 */

declare(strict_types=1);

require __DIR__ . '/console.php';
